{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MQDEsys LLM job report (report.json)",
  "type": "object",
  "required": [
    "job_id",
    "kind",
    "spec",
    "stages"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "llm"
      ]
    },
    "error": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "required": [
        "name",
        "recipes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "status",
          "seconds"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "skipped",
              "running"
            ]
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "env": {
      "type": "object"
    },
    "model": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "integer",
          "minimum": 1
        },
        "linears": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "ppl"
      ],
      "properties": {
        "ppl": {
          "type": "number",
          "minimum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "windows": {
          "type": "integer",
          "minimum": 1
        },
        "seq_len": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logits_probe": {
      "type": "object"
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "recipe",
          "algorithm",
          "layers"
        ],
        "properties": {
          "recipe": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "w_sqnr_db"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "w_sqnr_db": {
                  "type": "number"
                },
                "out_sqnr_db": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "shape": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "w_hist": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "min",
                    "max",
                    "n",
                    "counts"
                  ],
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1
                    }
                  }
                },
                "act_hist": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "min",
                    "max",
                    "n",
                    "counts"
                  ],
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1
                    }
                  }
                },
                "w_scale_summary": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "n",
                    "min",
                    "p50",
                    "p99",
                    "max"
                  ]
                }
              }
            }
          },
          "quantize_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eval": {
            "type": "object"
          },
          "logits": {
            "type": "object"
          },
          "summary": {
            "type": "object"
          }
        }
      }
    },
    "llamacpp": {
      "type": "object",
      "required": [
        "results"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "then": {
        "required": [
          "baseline",
          "recipes",
          "model",
          "env"
        ]
      }
    }
  ]
}
